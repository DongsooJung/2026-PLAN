{
  "manifest_version": 3,
  "name": "2026 PLAN",
  "description": "구독 관리 대시보드 & 공문서 변환기",
  "version": "1.0.0",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "2026 PLAN",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
