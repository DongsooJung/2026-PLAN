NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 결제일 알림(Web Push)용 ----------------------------------------------
# 서버가 모든 사용자 구독을 읽어 푸시를 보내기 위한 서비스 롤 키 (절대 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# VAPID 키 (npx web-push generate-vapid-keys 로 생성)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스에 전달할 연락처 (mailto: 형식)
VAPID_SUBJECT=mailto:admin@example.com

# Vercel Cron 보호용 시크릿 (Authorization: Bearer <값>)
CRON_SECRET=
